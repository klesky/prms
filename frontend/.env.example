# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Shared local-dev value; regenerate your own with: openssl rand -base64 32
NEXTAUTH_SECRET=FYx+jEzcXkWvHSzzThSTRs2eSofquMUFwv0zuC5jvtA=

# Keycloak (server-side only — never expose the secret to the browser)
KEYCLOAK_CLIENT_ID=rift-client
KEYCLOAK_CLIENT_SECRET=57f60454-a9d0-467d-90a9-bf1d6156389c
KEYCLOAK_ISSUER=http://localhost:9080/auth/realms/RIFTKeycloak
KEYCLOAK_END_SESSION_URL=http://localhost:9080/auth/realms/RIFTKeycloak/protocol/openid-connect/logout
KEYCLOAK_REFRESH_TOKEN_URL=http://localhost:9080/auth/realms/RIFTKeycloak/protocol/openid-connect/token

# Keycloak end-session URL (non-secret; used by the browser at logout)
NEXT_PUBLIC_KEYCLOAK_END_SESSION_URL=http://localhost:9080/auth/realms/RIFTKeycloak/protocol/openid-connect/logout

# PRMS backend API base (exposed to the browser for client-side calls)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
